# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=language_learning_hub
POSTGRES_PORT=5432
# Used by the backend container; service name "postgres" resolves inside docker-compose's network.
DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/language_learning_hub

# --- AI provider ---
# "gemini" (default, cloud) or "ollama" (local/offline)
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Used when AI_PROVIDER=ollama (and/or when running the optional "offline" compose profile)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma2:9b

# Max retries when the AI's JSON output fails schema/business-rule validation
AI_JSON_MAX_RETRIES=2

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173
# Base URL the frontend uses to call the backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1
