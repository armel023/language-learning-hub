# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=language_learning_hub
POSTGRES_PORT=5432
# Used by the backend container; service name "postgres" resolves inside docker-compose's network.
DATABASE_URL=postgresql+psycopg://app:change-me@postgres:5432/language_learning_hub

# --- AI provider ---
# "gemini" (default, cloud) or "ollama" (local/offline)
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Used when AI_PROVIDER=ollama (and/or when running the optional "offline" compose profile)
# Ollama installed on this machine (reached from the backend container via host.docker.internal).
# With the compose "offline" profile's container instead, use http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

# Max retries when the AI's JSON output fails schema/business-rule validation
AI_JSON_MAX_RETRIES=2

# Per-user AI token budget per UTC day, across all agent runs (0 = unlimited)
AI_DAILY_TOKEN_BUDGET=1000000

# --- Monitoring (self-hosted Arize Phoenix) ---
# Agent traces go here; UI at http://localhost:6006. Leave empty to disable trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006/v1/traces
OTEL_SERVICE_NAME=a2-deutsch-hub-backend
PHOENIX_PORT=6006

# --- Backend ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Max size of a vocab-extraction upload, in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# --- Frontend ---
FRONTEND_PORT=5173
# Base URL the frontend uses to call the backend API. Keep it relative (/api/v1): nginx (and the
# Vite dev server) proxy it to the backend, so the app works from localhost, Tailscale or LAN alike.
VITE_API_BASE_URL=/api/v1
